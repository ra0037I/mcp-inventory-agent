# Copy to .env and fill in ONE provider block (see SETUP.md).
# LLM_PROVIDER = openai | litellm | azure | ollama | mock
LLM_PROVIDER=openai

# --- OpenAI (direct) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- LiteLLM proxy (own proxy: python start_litellm.py, or the lecture proxy) ---
# LITELLM_KEY (used by agent.py) must be identical to LITELLM_MASTER_KEY (used by the own proxy).
# Generate one:  python -c "import secrets; print('sk-' + secrets.token_hex(24))"
# LiteLLM >= 1.105 refuses known defaults such as sk-1234.
LITELLM_API_BASE=http://localhost:4000
LITELLM_KEY=
LITELLM_MASTER_KEY=
LITELLM_DEFAULT_MODEL=gpt-4o-mini

# --- Azure OpenAI / Azure AI Foundry ---
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-10-21

# --- Ollama (local; model must support tool calling, e.g. qwen2.5:7b, llama3.1:8b) ---
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b

# --- Agent / MCP ---
MCP_TRANSPORT=stdio
MCP_SERVER_URL=http://127.0.0.1:8000/mcp
MAX_REACT_STEPS=10
LLM_TEMPERATURE=0
